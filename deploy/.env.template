# Names of the variables in deploy/.env, with what each one is. NO VALUES HERE.
# deploy/gen-secrets.sh writes the real file (mode 600) with fresh secrets; never copy values into this template.
# Names come from backend/src/main/resources/application.yml and BrajaProperties.

# Public host name served by Caddy (Let's Encrypt certificate). HTTPS is mandatory for push and geolocation.
BRAJA_DOMAIN=

# MySQL: password of the application user braja_app (also the backend's SPRING_DATASOURCE_PASSWORD) and of root.
# Both are applied only when the MySQL volume is created; changing them later does not change the database users.
SPRING_DATASOURCE_PASSWORD=
BRAJA_DB_ROOT_PASSWORD=

# 32-byte Base64 keys, one per purpose, never shared: AES-GCM of SALUD motives (losing it makes them unreadable),
# HMAC of the login IP throttle, AES of push subscriptions.
BRAJA_HEALTH_ENCRYPTION_KEY_BASE64=
BRAJA_LOGIN_IP_THROTTLE_KEY_BASE64=
BRAJA_PUSH_SUBSCRIPTION_ENCRYPTION_KEY_BASE64=

# Web Push (VAPID) on P-256, base64url without padding: public key = 65-byte uncompressed point, private key = 32-byte
# scalar. Subject: mailto:<email> or an https:// URL. Set all three or none (push off).
BRAJA_VAPID_PUBLIC_KEY=
BRAJA_VAPID_PRIVATE_KEY=
BRAJA_VAPID_SUBJECT=

# Docker network of the stack and Caddy's fixed address in it. docker-compose.yml derives
# BRAJA_TRUSTED_PROXY_CIDRS=<BRAJA_CADDY_IPV4>/32 from it, so only Caddy may set X-Forwarded-For.
BRAJA_NETWORK_SUBNET=
BRAJA_CADDY_IPV4=

# First ADMIN, created once on an empty database. deploy.sh sets ENABLED to false and empties the password after the
# first healthy deploy (a later start with the bootstrap on would fail). Password: 16 characters to 72 bytes.
BRAJA_BOOTSTRAP_ENABLED=
BRAJA_BOOTSTRAP_DNI=
BRAJA_BOOTSTRAP_PASSWORD=
BRAJA_BOOTSTRAP_ADMIN_NAME=
BRAJA_BOOTSTRAP_COMPANY_NAME=
BRAJA_BOOTSTRAP_SITE_NAME=
BRAJA_BOOTSTRAP_TIME_ZONE=

# Optional. Login IP throttle (defaults 100 failures, 15m window, 15m lock; D-20261027-05).
# BRAJA_LOGIN_IP_THROTTLE_MAX_FAILURES=
# BRAJA_LOGIN_IP_THROTTLE_WINDOW=
# BRAJA_LOGIN_IP_THROTTLE_LOCK_DURATION=

# Optional. Backups (deploy/backup.sh): directory (default ~/braja-backups), days kept (default 14) and the command that
# copies each new backup off the server; it receives the file path as $1.
# BRAJA_BACKUP_DIR=
# BRAJA_BACKUP_RETENTION_DAYS=
# BRAJA_BACKUP_OFFHOST_CMD=

# Optional, local verification only: host ports Caddy publishes (default 80 and 443).
# BRAJA_HTTP_PORT=
# BRAJA_HTTPS_PORT=
