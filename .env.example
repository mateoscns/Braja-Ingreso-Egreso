# Local development only. Generate a separate secret for every deployment.
BRAJA_DB_ROOT_PASSWORD=local_root_dev_only
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/braja?connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true
SPRING_DATASOURCE_USERNAME=braja_app
SPRING_DATASOURCE_PASSWORD=local_braja_dev_only
BRAJA_SESSION_COOKIE_SECURE=false

# Set a private 32-byte base64 key before testing SALUD motives. Never reuse this file in production.
BRAJA_HEALTH_ENCRYPTION_KEY_BASE64=

# Use a separate private 32-byte base64 key for login IP throttling.
BRAJA_LOGIN_IP_THROTTLE_KEY_BASE64=

# Use a different private 32-byte base64 key for Web Push subscription secrets.
BRAJA_PUSH_SUBSCRIPTION_ENCRYPTION_KEY_BASE64=

# Empty is permitted only with the local profile. Production must trust only the actual proxy network.
BRAJA_TRUSTED_PROXY_CIDRS=

# Optional as a group. Blank values disable outbound Web Push.
BRAJA_VAPID_PUBLIC_KEY=
BRAJA_VAPID_PRIVATE_KEY=
BRAJA_VAPID_SUBJECT=
